# Railway 環境變數設定範例
# 在 Railway Dashboard 設定這些變數

# Environment
NODE_ENV=production

# Database (Railway PostgreSQL 會自動提供)
# DATABASE_URL=postgresql://...

# Session Secret (請使用強密碼)
SESSION_SECRET=your-secure-session-secret-here

# OpenAI Compatible API
OPENAI_BASE_URL=https://globalai.vip/v1
OPENAI_API_KEY=your-api-key
OPENAI_MODEL_TEXT=gemini-3-flash-preview
OPENAI_MODEL_VISION=gemini-3-flash-preview
